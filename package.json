{
  "name": "slipbox",
  "version": "1.1.0",
  "description": "卡片盒：卢曼卡片笔记应用，macOS 与 Windows，数据保存在本机",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "python3 -m http.server --directory web 8790",
    "tauri": "tauri",
    "build:windows": "tauri build",
    "build:mac": "bash mac/build.sh",
    "install:mac": "bash mac/build.sh --install",
    "screenshots": "bash scripts/screenshots.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CamLUzy/slipbox.git"
  }
}

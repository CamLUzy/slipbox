{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "卡片盒",
  "mainBinaryName": "Slipbox",
  "version": "1.0.0",
  "identifier": "io.github.camluzy.slipbox",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CamLUzy",
    "homepage": "https://github.com/CamLUzy/slipbox",
    "copyright": "MIT License",
    "category": "Productivity",
    "shortDescription": "卢曼卡片笔记，数据保存在本机",
    "longDescription": "卡片盒是一个按卢曼卡片盒方法设计的笔记应用：固定编号、卡片链接、关键词索引、关系图和本地 AI，所有卡片都保存在这台电脑上。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
